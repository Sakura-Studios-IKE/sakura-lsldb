# Maintainer: Shiho Sakura <shiho@sakurastudios.eu>

pkgname=sakura-lsldb-git
_pkgname=sakura-lsldb
pkgver=1.0.0.r0.gHEAD
pkgrel=1
pkgdesc="LSL debugger frontend — drives sakura-slemu for interactive script debugging (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/Sakura-Studios-IKE/sakura-lsldb"
license=('MIT')
depends=('glibc' 'sakura-slemu')
makedepends=('gcc' 'make' 'git')
provides=('sakura-lsldb')
conflicts=('sakura-lsldb')
source=("$_pkgname::git+https://github.com/Sakura-Studios-IKE/sakura-lsldb.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
        || printf "0.0.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$srcdir/$_pkgname"
    make
}

package() {
    cd "$srcdir/$_pkgname"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
